{
  "name": "iata-app",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma IATA - Instrumento Abierto de Transparencia Académica",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build:shared": "npm run build -w shared",
    "vercel-build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "test:server": "npm run test -w server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.22.0"
  }
}
