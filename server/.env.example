# ─── Database ────────────────────────────────────────────────────────────────
# Neon Tech PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─── Authentication ──────────────────────────────────────────────────────────
# Secret key for signing JWT tokens (use a strong random string)
JWT_SECRET=your-jwt-secret-here

# JWT token expiration in hours (default: 24, range: 1-168)
JWT_EXPIRATION_HOURS=24

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of API keys
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the Express server (default: 3001)
PORT=3001
